{
  "manifest_version": 3,
  "name": "ChatGPT",
  "version": "1.3.3",
  "description": "复制 ChatGPT 回答为 Markdown（保留 Mermaid 源码）、飞书公式格式、表格 Markdown，以及动态展示区域图片。",
  "permissions": ["contextMenus", "clipboardWrite"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*"],
    "js": ["mermaid-source.js"],
    "world": "MAIN",
    "run_at": "document_idle"
  }, {
    "matches": ["https://chatgpt.com/*"],
    "js": ["vendor/html-to-image.js", "copy-feedback.js", "converter.js", "tables.js", "boxes.js", "markdown.js", "content.js"],
    "run_at": "document_idle"
  }]
}
